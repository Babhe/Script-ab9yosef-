-- زر إضافة أمان أكبر (Anti-Cheat Bypass)
local safetyBtn = Instance.new("TextButton", main)
safetyBtn.Size = UDim2.new(1, -24, 0, 35)
safetyBtn.Position = UDim2.new(0, 12, 0, 95)
safetyBtn.BackgroundColor3 = Color3.fromRGB(41, 128, 185)
safetyBtn.Text = "🛡️ تفعيل الحماية القصوى: إيقاف"
safetyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
safetyBtn.TextSize = 13
safetyBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", safetyBtn).CornerRadius = UDim.new(0, 6)

local maxSafety = false
safetyBtn.MouseButton1Click:Connect(function()
    maxSafety = not maxSafety
    if maxSafety then
        safetyBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        safetyBtn.Text = "🛡️ تفعيل الحماية القصوى: شغال ✅"
    else
        safetyBtn.BackgroundColor3 = Color3.fromRGB(41, 128, 185)
        safetyBtn.Text = "🛡️ تفعيل الحماية القصوى: إيقاف"
    end
end)

-- زر تفعيل الترفيع (الهيدروليك)
local heightBtn = Instance.new("TextButton", main)
heightBtn.Size = UDim2.new(1, -24, 0, 35)
heightBtn.Position = UDim2.new(0, 12, 0, 140)
heightBtn.BackgroundColor3 = Color3.fromRGB(142, 68, 173)
heightBtn.Text = "🚘 وزنية الترفيع (الهيدروليك): إيقاف"
heightBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
heightBtn.TextSize = 13
heightBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", heightBtn).CornerRadius = UDim.new(0, 6)

local isLifted = false
heightBtn.MouseButton1Click:Connect(function()
    isLifted = not isLifted
    local seat = Player.Character and Player.Character:FindFirstChild("Humanoid") and Player.Character.Humanoid.SeatPart
    if seat and seat:IsA("VehicleSeat") then
        if isLifted then
            heightBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            heightBtn.Text = "🚘 وزنية الترفيع (الهيدروليك): مرفوعة ⬆️"
            seat.Parent:PivotTo(seat.CFrame + Vector3.new(0, 3.5, 0)) -- ترفيع ممتاز عن الأرض
        else
            heightBtn.BackgroundColor3 = Color3.fromRGB(142, 68, 173)
            heightBtn.Text = "🚘 وزنية الترفيع (الهيدروليك): إيقاف"
            seat.Parent:PivotTo(seat.CFrame - Vector3.new(0, 3.5, 0))
        end
    else
        heightBtn.Text = "اركب السيارة أولاً! ⚠️"
        isLifted = false
        task.wait(1)
        heightBtn.Text = "🚘 وزنية الترفيع (الهيدروليك): إيقاف"
    end
end)

-- زر التجميع الرئيسي
local toggleBtn = Instance.new("TextButton", main)
toggleBtn.Size = UDim2.new(1, -24, 0, 45)
toggleBtn.Position = UDim2.new(0, 12, 0, 195)
toggleBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43) 
toggleBtn.Text = "شغل التجميع ياقلبي"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextSize = 15
toggleBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

local isFarming = false
local farmConnection = nil

toggleBtn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    local seat = Player.Character and Player.Character:FindFirstChild("Humanoid") and Player.Character.Humanoid.SeatPart
    
    if isFarming then
        if seat and seat:IsA("VehicleSeat") then
            toggleBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96) 
            toggleBtn.Text = "وقف التجميع ياقلبي"
            
            local savedCFrame = seat.CFrame
            
            farmConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if not isFarming or not seat or not seat.Parent then
                    if farmConnection then farmConnection:Disconnect() end
                    return
                end
                
                pcall(function()
                    -- السرعة السحرية الثابتة عشان تنزل الفلوس
                    local targetSpeed = math.random(135, 145)
                    
                    -- إذا شغال زر الحماية القصوى، يسوي تقطيع خفيف جداً بالسرعة يخدع الرادار
                    if maxSafety then
                        targetSpeed = targetSpeed - math.random(2, 7)
                    end
                    
                    speedLabel.Text = "السرعة الحالية: " .. targetSpeed .. " كم/س"
                    
                    -- إعطاء قوة دفع مستقيمة
                    seat.AssemblyLinearVelocity = savedCFrame.LookVector * targetSpeed
                    
                    -- تثبيت السيارة في مكانها مع مراعاة الترفيع إذا كان شغال
                    if isLifted then
                        seat.Parent:PivotTo(CFrame.new(savedCFrame.Position + Vector3.new(0, 3.5, 0)) * savedCFrame.Rotation)
                    else
                        seat.Parent:PivotTo(savedCFrame)
                    end
                end)
            end)
        else
            isFarming = false
            toggleBtn.Text = "اركب مقعد السائق أولاً! ⚠️"
            task.wait(1.5)
            toggleBtn.Text = "شغل التجميع ياقلبي"
        end
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
        toggleBtn.Text = "شغل التجميع ياقلبي"
        speedLabel.Text = "السرعة الحالية: 0 كم/س"
        if farmConnection then
            farmConnection:Disconnect()
            farmConnection = nil
        end
        pcall(function()
            if seat and seat:IsA("VehicleSeat") then
                seat.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end)
    end
end)
 
