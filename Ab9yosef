-- سكريبت تخطي محدد السرعة (41 كم/س)
local player = game.Players.LocalPlayer
local runService = game:GetService("RunService")

print("--- [AbuYousef] محاولة كسر حاجز السرعة ---")

runService.Heartbeat:Connect(function()
    local character = player.Character
    if character and character:FindFirstChild("Humanoid") then
        local seat = character.Humanoid.SeatPart
        
        if seat and seat:IsA("VehicleSeat") then
            -- 1. جبر السيارة على ضغط البنزين كامل (Throttle)
            seat.Throttle = 1 
            
            -- 2. دفع فيزيائي أقوى (بدل ما نحدد 145، نخليه يدفع باستمرار)
            seat.AssemblyLinearVelocity = seat.CFrame.LookVector * 145
            
            -- 3. تثبيت التوجيه (عشان ما يلف الموتر)
            seat.Steer = 0
        end
    end
end)

