-- ====================================================================
-- 👑 النسخة الملكية الخاصة بالمالك: أبو يوسف 👑
-- ⚙️ نظام "العداد الخارق" - السيارة ثابتة والعداد يطير بجنون
-- ====================================================================

local LocalPlayer = game.Players.LocalPlayer

-- اللوحة الرئيسية الفخمة باللون اللي تحبه (Charcoal Dark Green)
local sg = Instance.new("ScreenGui", game.Players.LocalPlayer:WaitForChild("PlayerGui"))
local main = Instance.new("Frame", sg)
main.Size = UDim2.new(0, 330, 0, 180)
main.Position = UDim2.new(0.5, -165, 0.4, -90)
main.BackgroundColor3 = Color3.fromRGB(33, 43, 43) -- لونك المفضل
main.Active = true
main.Draggable = true

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)
local stroke = Instance.new("UIStroke", main)
stroke.Color = Color3.fromRGB(255, 215, 0) -- تحديد ذهبي فخم للمالك
stroke.Thickness = 2

-- الحقوق الثابتة للمالك
local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "👑 لوحة المالك أبو يوسف - تجميع خارق 👑"
title.TextColor3 = Color3.fromRGB(255, 215, 0)
title.TextSize = 14
title.Font = Enum.Font.GothamBold

-- عداد السرعة الجنونية
local speedLabel = Instance.new("TextLabel", main)
speedLabel.Size = UDim2.new(1, 0, 0, 40)
speedLabel.Position = UDim2.new(0, 0, 0, 50)
speedLabel.Text = "السرعة الحالية: 0 كم/س"
speedLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
speedLabel.BackgroundTransparency = 1
speedLabel.TextSize = 15
speedLabel.Font = Enum.Font.GothamMedium

-- زر التشغيل الإمبراطوري
local toggleBtn = Instance.new("TextButton", main)
toggleBtn.Size = UDim2.new(0.9, 0, 0, 45)
toggleBtn.Position = UDim2.new(0.05, 0, 0, 110)
toggleBtn.Text = "تفعيل العداد الخارق 🔥"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
toggleBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

local isFarming = false
local farmConnection = nil

toggleBtn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    local seat = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") and game.Players.LocalPlayer.Character.Humanoid.SeatPart
    
    if isFarming then
        if seat and seat:IsA("VehicleSeat") then
            toggleBtn.Text = "إيقاف التجميع السريع"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
            
            -- تثبيت السيارة في الأرض 100% عشان ما تلف ولا تتحرك مكاانها
            seat.Parent:PivotTo(seat.CFrame)
            for _, part in pairs(seat.Parent:GetDescendants()) do
                if part:IsA("BasePart") then part.Anchored = true end
            end
            
            -- تسريع العداد لأرقام خيالية تتعدى الـ 1000 بالثانية لصب الفلوس
            farmConnection = game:GetService("RunService").Heartbeat:Connect(function()
                speedLabel.Text = "السرعة: " .. math.random(999, 1500) .. " كم/س (حد أقصى) ⚡"
                
                -- إرسال إشارات السرعة مباشرة للكرسي عشان اللعبة تحسب فلوس والسيارة واقفة
                pcall(function()
                    seat.Velocity = Vector3.new(0, 0, math.random(100, 200))
                end)
            end)
        else
            toggleBtn.Text = "اركب مقعد السائق أولاً يالأمير! ⚠️"
            isFarming = false
            task.wait(1.5)
            toggleBtn.Text = "تفعيل العداد الخارق 🔥"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        end
    else
        toggleBtn.Text = "تفعيل العداد الخارق 🔥"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        speedLabel.Text = "السرعة الحالية: 0 كم/س"
        
        if farmConnection then farmConnection:Disconnect() end
        
        -- إلغاء تثبيت السيارة عشان تقدر تسوقها طبيعي بعد ما تخلص تجميع
        if seat and seat.Parent then
            for _, part in pairs(seat.Parent:GetDescendants()) do
                if part:IsA("BasePart") then part.Anchored = false end
            end
        end
    end
end)
